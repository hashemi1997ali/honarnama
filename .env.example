# Copy this file to .env. The PHP backend loads the root .env automatically.
# Keep real credentials out of Git.

# Pooled connection for normal API traffic.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# Direct connection for schema migrations. Get it from Neon with pooling off.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# Legacy Android request identifier. This is extractable from the APK and is
# not a substitute for real user authentication.
SECURITY_CODE=replace-with-a-random-local-value

# Initial panel administrator, created only when it does not already exist.
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters

# Optional SMTP. Leave blank to keep seeded email notifications disabled.
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587

# Android reference values. Android Studio reads Market/local.properties,
# not this file, unless these are exported as process environment variables.
BACKEND_URL=http://10.0.2.2:8000/panel/
CONTACT_EMAIL=contact@example.com
