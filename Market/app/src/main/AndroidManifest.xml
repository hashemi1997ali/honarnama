<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <!-- List Of Activity Class -->
        <activity
            android:name="ir.hashemi.market.ActivitySplash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="ir.hashemi.market.ActivityLogin" />
        <activity android:name="ir.hashemi.market.ActivityRegister" />
        <activity android:name="ir.hashemi.market.ActivityMain" />
        <activity android:name="ir.hashemi.market.ActivityInstruction" />
        <activity android:name="ir.hashemi.market.ActivityNewsInfo" />
        <activity android:name="ir.hashemi.market.ActivityNewsInfoDetails" />
        <activity android:name="ir.hashemi.market.ActivityCategoryDetails" />
        <activity android:name="ir.hashemi.market.ActivityProductDetails" />
        <activity android:name="ir.hashemi.market.ActivityFullScreenImage" />
        <activity android:name="ir.hashemi.market.ActivitySearch" />
        <activity android:name="ir.hashemi.market.ActivityWishlist" />
        <activity android:name="ir.hashemi.market.ActivityShoppingCart" />
        <activity android:name="ir.hashemi.market.ActivityCheckout" />
        <activity android:name="ir.hashemi.market.ActivityOrderHistory" />
        <activity android:name="ir.hashemi.market.ActivityAuctionDetails" />
        <activity android:name="ir.hashemi.market.ActivityProductAuctionDetails" />
        <activity
            android:name="ir.hashemi.market.ActivitySettings"
            android:theme="@style/AppThemeSetting" />

    </application>

</manifest>
